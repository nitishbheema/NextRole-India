# Environment Variables — Safe Example Placeholders
# Copy this file to .env and fill in real values.
# NEVER commit real credentials to source control.

# =============================================================================
# BACKEND — Spring Boot (set in Render Web Service environment variables)
# =============================================================================

# Neon PostgreSQL connection (from Neon Console → Connection Details → Connection string)
DATABASE_URL=jdbc:postgresql://ep-example-12345.ap-southeast-1.aws.neon.tech/nextrole?sslmode=require
DATABASE_USERNAME=nextrole_user
DATABASE_PASSWORD=your-neon-password-here

# Allowed frontend origin (your Render static site URL, no trailing slash)
CORS_ALLOWED_ORIGINS=https://nextroleindia.onrender.com

# Admin bootstrap credentials (change immediately after first deployment)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password

# Spring Boot profile
SPRING_PROFILES_ACTIVE=prod

# =============================================================================
# GITHUB ACTIONS SECRETS (set in repository Settings → Secrets → Actions)
# =============================================================================
# These same DATABASE_URL / USERNAME / PASSWORD values must be set as
# repository secrets for GitHub Actions to connect during scheduled sync.

# =============================================================================
# FRONTEND — Vite (set in Render Static Site environment variables)
# =============================================================================

# Your deployed backend URL (no trailing slash)
VITE_API_BASE_URL=https://nextrole-api.onrender.com
